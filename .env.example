ANTHROPIC_API_KEY=sk-ant-...

# Opcional
# CORTAGO_CLAUDE_MODEL=claude-opus-5-5
# CORTAGO_CLAUDE_EFFORT=medium
# Transcrição e encoder são automáticos. Para forçar:
# CORTAGO_WHISPER_BACKEND=faster-whisper     # mlx | faster-whisper
# CORTAGO_WHISPER_MODEL=small                # em PCs só com CPU, acelera a transcrição
# CORTAGO_VIDEO_ENCODER=libx264              # libx264 | h264_nvenc | h264_qsv | h264_amf | h264_videotoolbox
# CORTAGO_MUSIC_DIR=data/music
# CORTAGO_MUSIC_GAP_DB=12   # quantos dB a música fica abaixo do áudio do vídeo

# Personalização do canal
# CORTAGO_CHANNEL_CONTEXT=um canal brasileiro de cortes de games no YouTube Shorts
# CORTAGO_HIGHLIGHT_COLOR=#FFE500
# CORTAGO_HOOK_BOX_COLOR=#000000
# CORTAGO_YT_CATEGORY=Jogos
# CORTAGO_YT_LANGUAGE=Português (Brasil)
# CORTAGO_YT_EXTRA_TAGS=games,cortes de games
